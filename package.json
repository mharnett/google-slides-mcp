{
  "name": "google-slides-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Slides integration",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && node -e \"fs=require('fs');cp=require('child_process');sha=cp.execSync('git rev-parse --short HEAD 2>/dev/null||echo unknown').toString().trim();fs.writeFileSync('build/build-info.json',JSON.stringify({sha,builtAt:new Date().toISOString()}))\"",
    "start": "node build/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "get-token": "npm run build && node build/getRefreshToken.js",
    "smoke": "scripts/healthcheck.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "cockatiel": "^3.2.1",
    "googleapis": "^148.0.0",
    "open": "^10.1.1",
    "pino": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "server-destroy": "^1.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^22.14.1",
    "@types/server-destroy": "^1.0.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0-alpha.59",
    "vitest": "^4.0.18"
  }
}
